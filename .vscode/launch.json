{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug WhatsApp Gateway (backend/cmd/api)",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/backend/cmd/api",
      "cwd": "${workspaceFolder}/backend",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PORT": "8082",
        "ALLOWED_ORIGINS": "http://localhost:8080,http://localhost:8081,http://localhost:8082,http://localhost:3000"
      },
      "console": "integratedTerminal",
      "showLog": true
    },
    {
      "name": "Run WhatsApp Gateway (sem debug)",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/backend/cmd/api",
      "cwd": "${workspaceFolder}/backend",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PORT": "8082",
        "ALLOWED_ORIGINS": "http://localhost:8080,http://localhost:8081,http://localhost:8082,http://localhost:3000"
      },
      "console": "integratedTerminal"
    },
    {
      "name": "Run DB Migrations (backend/cmd/migrate)",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/backend/cmd/migrate",
      "cwd": "${workspaceFolder}/backend",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "DATABASE_URL": "postgresql://gateway:gateway@localhost:5433/whatsapp_gateway?sslmode=disable"
      },
      "console": "integratedTerminal",
      "showLog": true
    }
  ]
}
