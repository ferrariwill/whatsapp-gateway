# Ambiente local — WhatsApp Gateway
# Copie para .env:  cp .env.example .env

# -----------------------------------------------------------------------------
# PostgreSQL local (acesso a partir da sua máquina / go run)
# Porta 5433 evita conflito com outro Postgres na 5432.
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5433
DB_USER=gateway
DB_PASSWORD=gateway
DB_NAME=whatsapp_gateway

# Connection string usada pelo app Go (host = localhost quando roda fora do Docker)
DATABASE_URL=postgresql://gateway:gateway@localhost:5433/whatsapp_gateway?sslmode=disable

# -----------------------------------------------------------------------------
# Segurança
# -----------------------------------------------------------------------------
# JWT do painel web (mínimo 32 caracteres)
JWT_SECRET=local-dev-jwt-secret-min-32-chars!!

# false em dev local (HTTP); true no Render (HTTPS)
COOKIE_SECURE=false

# -----------------------------------------------------------------------------
# Meta WhatsApp Cloud API
# -----------------------------------------------------------------------------
# Único token fixo no servidor — validação do webhook único na Meta (hub.verify_token)
META_WEBHOOK_VERIFY_TOKEN=local-meta-verify-token

# Embedded Signup (OAuth redirect callback)
META_APP_ID=
META_APP_SECRET=
# Deve ser idêntica à URL cadastrada em Valid OAuth Redirect URIs no app Meta
META_EMBEDDED_SIGNUP_REDIRECT_URI=https://seu-gateway/meta/embedded-signup/callback

# Embedded Signup OAuth state: {slug}_{tenant_id} — slug vem de systems.slug no painel (ex.: beleza_789, clinica_42, beleza_web_789)
BELEZA_SAAS_WEBHOOK_URL=
# Ex.: CLINICA_SAAS_WEBHOOK_URL= para outros produtos

# URL de fallback para repassar mensagens recebidas (se whatsapp_connections.webhook_url estiver vazio)
MOTHER_SYSTEM_WEBHOOK_URL=

# Credenciais Meta por tenant ficam em whatsapp_connections (banco), não aqui.
# Para diagnóstico local (go run ./cmd/meta-test), use variáveis de teste opcionais:
# META_TEST_ACCESS_TOKEN=
# META_TEST_WABA_ID=
# META_TEST_PHONE_NUMBER_ID=

# Limite mensal de disparos por cliente externo (proteção contra abuso)
MONTHLY_MESSAGE_LIMIT=3000

# Rate limit por minuto (por system_id + tenant_id) — bloqueio automático anti-spam
MAX_MESSAGES_PER_MINUTE=50

# Alerta de segurança enviado ao administrador quando um tenant é bloqueado por spam
ADMIN_PHONE_NUMBER=
# Chip Meta (phone_number_id) e token usados para enviar o alerta ao administrador
ADMIN_ALERT_PHONE_NUMBER_ID=
ADMIN_ALERT_ACCESS_TOKEN=
# Opcional: template aprovado na Meta para alertas (corpo com {{1}} app, {{2}} client, {{3}} count)
ADMIN_ALERT_TEMPLATE_NAME=

# -----------------------------------------------------------------------------
# Servidor
# -----------------------------------------------------------------------------
PORT=8080
META_API_VERSION=v21.0

# CORS — origens permitidas (separadas por vírgula)
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000

# -----------------------------------------------------------------------------
# Dados de teste (scripts/seed-local.sql)
# API Key de exemplo já cadastrada no seed local:
#   sk_live_local_test_key_0123456789abcdef0123456789ab
# Login do painel (migration 000002):
#   ferrariwill@gmail.com / 123456
# Cadastre conexões multi-tenant no painel (seção Conexões WhatsApp) ou via SQL.
